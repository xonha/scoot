{
    "manufacturer": "xonha",
    "keyboard_name": "scoot",
    "maintainer": "xonha",
    "comment": "Scoot: 42-key unibody split. SINGLE RP2040-Zero on the left half; the right half is passive matrix + a PMW3360 desk-mouse sensor + a roller scroll wheel, all carried over the USB-C tether. This is NOT a QMK split (no second MCU) -> SPLIT_KEYBOARD stays off.",

    "processor": "RP2040",
    "bootloader": "rp2040",

    "diode_direction": "COL2ROW",
    "matrix_pins": {
        "rows": ["GP0", "GP1", "GP2", "GP3", "GP4", "GP5"],
        "cols": ["GP6", "GP7", "GP10", "GP11", "GP12", "GP13", "GP17", "GP18"]
    },

    "encoder": {
        "rotary": [
            { "pin_a": "GP26", "pin_b": "GP27" },
            { "pin_a": "GP28", "pin_b": "GP29" }
        ]
    },

    "usb": {
        "vid": "0xFEED",
        "pid": "0x0001",
        "device_version": "1.0.0"
    },

    "layouts": {
        "LAYOUT": {
